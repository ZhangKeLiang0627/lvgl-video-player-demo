+/* ---- additional player control API (pause / seek / time / duration) ---- */
+
+int32_t lv_ffmpeg_player_get_duration(lv_obj_t * obj)
+{
+    lv_ffmpeg_player_t * player = (lv_ffmpeg_player_t *)obj;
+    if(!player || !player->ffmpeg_ctx) return 0;
+    AVFormatContext * fc = player->ffmpeg_ctx->fmt_ctx;
+    int64_t d = (fc->duration != AV_NOPTS_VALUE) ? fc->duration : 0;
+    if(d <= 0) {                       /* fallback: longest stream duration */
+        for(unsigned i = 0; i < fc->nb_streams; i++) {
+            AVStream * st = fc->streams[i];
+            if(st && st->duration != AV_NOPTS_VALUE && st->duration > 0) {
+                int64_t sd = av_rescale_q(st->duration, st->time_base, AV_TIME_BASE_Q);
+                if(sd > d) d = sd;
+            }
+        }
+    }
+    if(d <= 0) return 0;
+    return (int32_t)(d / 1000);   /* microseconds -> ms */
+}
+
+int32_t lv_ffmpeg_player_get_time(lv_obj_t * obj)
+{
+    lv_ffmpeg_player_t * player = (lv_ffmpeg_player_t *)obj;
+    if(!player || !player->ffmpeg_ctx) return 0;
+    struct ffmpeg_context_s * c = player->ffmpeg_ctx;
+    int64_t now_us = av_gettime_relative();
+    int64_t e;
+    if(c->paused) e = c->pause_start_us - c->play_start_us - c->paused_accum_us;
+    else          e = now_us - c->play_start_us - c->paused_accum_us;
+    if(e < 0) e = 0;
+    return (int32_t)(e / 1000);
+}
+
+lv_result_t lv_ffmpeg_player_pause(lv_obj_t * obj)
+{
+    lv_ffmpeg_player_t * player = (lv_ffmpeg_player_t *)obj;
+    if(!player || !player->ffmpeg_ctx) return LV_RESULT_INVALID;
+    struct ffmpeg_context_s * c = player->ffmpeg_ctx;
+    if(c->paused) return LV_RESULT_OK;
+    c->paused = true;
+    c->pause_start_us = av_gettime_relative();
+    return LV_RESULT_OK;
+}
+
+lv_result_t lv_ffmpeg_player_resume(lv_obj_t * obj)
+{
+    lv_ffmpeg_player_t * player = (lv_ffmpeg_player_t *)obj;
+    if(!player || !player->ffmpeg_ctx) return LV_RESULT_INVALID;
+    struct ffmpeg_context_s * c = player->ffmpeg_ctx;
+    if(!c->paused) return LV_RESULT_OK;
+    c->paused_accum_us += av_gettime_relative() - c->pause_start_us;
+    c->paused = false;
+    return LV_RESULT_OK;
+}
+
+lv_result_t lv_ffmpeg_player_seek(lv_obj_t * obj, int32_t ms)
+{
+    lv_ffmpeg_player_t * player = (lv_ffmpeg_player_t *)obj;
+    if(!player || !player->ffmpeg_ctx) return LV_RESULT_INVALID;
+    struct ffmpeg_context_s * c = player->ffmpeg_ctx;
+    AVFormatContext * fc = c->fmt_ctx;
+    int64_t target_us = (int64_t)ms * 1000;
+    int vst = (c->video_stream) ? (int)c->video_stream->index : -1;
+    int64_t ts = av_rescale_q(target_us, AV_TIME_BASE_Q, c->tb);
+    av_seek_frame(fc, vst >= 0 ? vst : -1, ts, AVSEEK_FLAG_BACKWARD);
+    /* re-anchor wall clock so get_time() returns ms */
+    c->play_start_us = av_gettime_relative() - target_us - c->paused_accum_us;
+    return LV_RESULT_OK;
 }
 
